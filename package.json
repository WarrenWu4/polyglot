{
  "name": "polyglot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:init": "wrangler d1 execute polyglot_dev --local --file=db/schema.sql",
    "db:seed": "wrangler d1 execute polyglot_dev --local --file=db/seed_1500_common_chinese_characters.sql",
    "db:seed:remote": "wrangler d1 execute polyglot_dev --remote --file=db/seed_1500_common_chinese_characters.sql",
    "db:init:remote": "wrangler d1 execute polyglot_dev --remote --file=db/schema.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:init"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "hono": "^4.13.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
